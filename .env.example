# Environment Settings
ENV=dev
SERVER_PORT=8080
LOG_LEVEL=info

# Database
DATABASE_URL=postgres://user:pass@localhost:5432/uploaddb?sslmode=disable

# Rate Limiting
RATE_LIMIT=10
RATE_BURST=20

# Auth0 Configuration
AUTH0_DOMAIN=your-tenant.auth0.com
AUTH0_AUDIENCE=https://your-api-identifier

# AWS Configuration
AWS_REGION=us-east-1
AWS_S3_BUCKET=your-bucket-name

# Server Timeouts
READ_TIMEOUT=5s
WRITE_TIMEOUT=10s
IDLE_TIMEOUT=60s